# Docker

DOCKER_PORT=8080
DOCKER_HOST=127.0.0.1

DOCKER_RAM_MIN=128M
DOCKER_RAM_MAX=512M

DOCKER_CPU_MIN=1
DOCKER_CPU_MAX=2

# Hyde

SYSTEM_LOG_DELAY=60
CONSOLE_CLEANER_DELAY=300

DEBUG=0

# Fractal

INSTRUCTION_LIMIT_ENABLED=1
INSTRUCTION_LIMIT=10000

# Hawk

HAWK_PORT=8080
HAWK_HOST=0.0.0.0

WORKER_POOL_THREADS=4