# Docker

DOCKER_PORT=8080 # Output port of the docker container
DOCKER_HOST=127.0.0.1 # Output host of the docker container

DOCKER_RAM_MIN=128M # Minimal amount of RAM that will be allocated
DOCKER_RAM_MAX=512M # Maximal amount of RAM that the container can use

DOCKER_CPU_MIN=1 # Minimal amount of CPU cores that will be allocated
DOCKER_CPU_MAX=2 # Maximal amount of CPU cores that the container can use

# Hyde

SYSTEM_LOG_DELAY=60 # Delay in seconds between resource utilisation logs
CONSOLE_CLEANER_DELAY=300 # Delay between console cleans

DEBUG=1 # Determines if standard logs are enabled, when disabled only warnings will appear in console

# Fractal

INSTRUCTION_LIMIT_ENABLED=1 # Enables an instruction limit, it is recommended to use so while true loops don't block workers
INSTRUCTION_LIMIT=10000 # Amount of instructions that will be processed before Fractal interpreter will stop

BYTECODE_INDENTATION=1 # When enabled Fractal bytecode will be indented, it can be turned off to save disk space however it will be harder to debug it if needed

# Hawk

HAWK_PORT=8080 # Port of Hawk instance
HAWK_HOST=0.0.0.0 # Host of Hawk instance

WORKER_POOL_THREADS=4 # Amount of workers that will be used to execute Fractal bytecode